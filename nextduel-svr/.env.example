# Local development settings for `go run .` (loaded from this directory).
# `npm run setup` at the repo root copies this to .env and picks a free PORT.
# The Vite dev server reads PORT from here too, so its proxy always matches.
# Full variable reference: ../.env.example

PORT=8080
DB_PATH=nextduel.db
# Lets the backend serve the production build at http://localhost:PORT
# (after `npm run build`). In dev, use the Vite URL instead.
HTML_ROOT=../nextduel-frontend/dist

# Create an "admin" account on first start (local convenience). Leave empty to skip.
ADMIN_PASSWORD=

OPENTDB_ENABLED=true
LOG_FORMAT=text
LOG_LEVEL=info

# Shorter timers make manual testing quicker; defaults are 5 / 60 / 10 / 5.
GAME_ROUNDS=5
GAME_ROUND_SECONDS=30
GAME_FAST_DUEL_SECONDS=10
GAME_INTERMISSION_SECONDS=4
