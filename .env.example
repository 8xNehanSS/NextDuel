# Copy to .env (repo root for docker compose, or nextduel-svr/ for local runs).
# Every variable is optional; defaults are shown.

# --- docker compose only ----------------------------------------------------
# Public hostname Caddy serves and requests a TLS certificate for.
DOMAIN=localhost
VERSION=dev

# --- nex-server framework ---------------------------------------------------
PORT=8080
# Name of the session cookie.
COOKIE_KEY=NEX_SERVER
# Directory containing the built frontend (nextduel-frontend/dist).
HTML_ROOT=../nextduel-frontend/dist

# --- NextDuel -----------------------------------------------------------------
DB_PATH=nextduel.db
# When set, creates an "admin" account on first start. Leave empty to skip.
ADMIN_PASSWORD=
# Use X-Forwarded-For for client IPs (rate limiting). Only enable behind a proxy.
TRUST_PROXY=false
# Extra origins allowed to open the websocket (comma separated). Same-origin
# is always allowed.
ALLOWED_ORIGINS=
# Fetch fresh questions from opentdb.com (falls back to the local bank).
OPENTDB_ENABLED=true
# text | json
LOG_FORMAT=text
# debug | info | warn | error
LOG_LEVEL=info

# --- Game tuning --------------------------------------------------------------
GAME_ROUNDS=5
GAME_ROUND_SECONDS=60
GAME_FAST_DUEL_SECONDS=10
GAME_INTERMISSION_SECONDS=5
